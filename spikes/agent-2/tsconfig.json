{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../src/*"
      ],
      "@fixtures/*": [
        "../../fixtures/*"
      ]
    }
  },
  "include": [
    "*.ts"
  ]
}