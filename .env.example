# Chronodex environment variables (MASTER.md section 8.2).
# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# A variable that is not listed here does not exist (MASTER.md 8.4 rule 8).

# --- Server and worker only. Never prefix these with NEXT_PUBLIC_. ---

# fal API key. Every fal call runs on the server or the worker.
FAL_KEY=

# DeepSeek API key (platform.deepseek.com): the guide chat and the Historian. Claude is not used (D-026).
DEEPSEEK_API_KEY=

# MongoDB Atlas connection string, for example mongodb+srv://USER:PASSWORD@CLUSTER/...
MONGODB_URI=

# Database name. Use your own while developing (chronodex_dev_<name>), chronodex for the demo.
MONGODB_DB=chronodex_dev_yourname

# DeepSeek model for the guide chat. Defaults to deepseek-flash. Anything not starting deepseek- is ignored.
CHAT_MODEL=deepseek-flash

# DeepSeek model for the Historian (research with web search, then writing). Defaults to deepseek-flash.
# deepseek-v4-pro failed mid-stream with the web tools on 14 Nov 2026, so leave this empty unless you test it.
HISTORIAN_MODEL=

# on or off. off refuses the video tier, which is about eight times the cost of the core tier.
VIDEO_GENERATION=off

# Comma-separated era ids that may get the video tier while VIDEO_GENERATION=on, for example queens-tower_1893.
# Empty means none: turning video on then cannot spend on every era a player opens.
VIDEO_ERAS=

# 1 accepts captures marked as spoofed by the dev spoof panel. Development only. Leave empty in the demo.
ALLOW_SPOOFED_LOCATION=

# How many era jobs the worker (`npm run worker`) runs at once. Defaults to 1. Each job spends fal and
# DeepSeek credits, and fal rate-limits, so raise it only on purpose.
WORKER_CONCURRENCY=

# 1 lets the worker run on a private in-memory queue when MONGODB_URI is not set. For trying the worker
# loop only: it cannot see jobs the website queued, because they are in another process's memory.
WORKER_ALLOW_MEMORY=
# Folder holding the Archivist's data files. Defaults to ./data. Only tests and odd checkouts need this.
ARCHIVE_DIR=
# Failed generation jobs an era may have before POST /generate answers 429 retry_limit. Defaults to 2. Each failure spent credits.
MAX_FAILED_JOBS_PER_ERA=
# 1 lets POST /api/eras/<id>/generate?force=1 skip that limit. Development only.
ALLOW_FORCE_GENERATE=
# Folder for the durable media store when there is no MONGODB_URI (Agent 4's src/lib/media). Defaults to ./media (git-ignored).
MEDIA_DIR=

# Extra hostnames allowed to load the dev server (`npm run dev`), comma-separated, no scheme or port,
# for example my-laptop.local,demo.example.com. This machine's LAN IPs and common tunnels
# (ngrok, Cloudflare, localtunnel, VS Code dev tunnels) are already allowed. Restart dev after changing.
DEV_ALLOWED_ORIGINS=

# --- Browser. Read at build time: restart `npm run dev` after changing. ---

# 1 serves fixtures instead of calling the API (MASTER.md 4.5). No keys or database needed.
NEXT_PUBLIC_USE_MOCKS=1

# 1 shows the location-spoof panel.
NEXT_PUBLIC_DEV_TOOLS=
