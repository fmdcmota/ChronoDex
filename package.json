{
  "name": "chronodex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.11.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/gyroscope-plugin": "^5.15.1",
    "maplibre-gl": "^6.18.0",
    "mongodb": "^7.9.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsdoc": "^65.4.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
